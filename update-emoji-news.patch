@@ -0,0 +1,170 @@
+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+import {
+  adminApproveEmojiSuggestion,
+  adminListEmojiSuggestions,
+  adminRejectEmojiSuggestion,
+  emojiAssetUrl,
+  type EmojiSuggestion,
+} from "@/lib/gameActions";
+import { EMOJI_NAME_MAX, EMOJI_PRICE_MAX } from "@/lib/emojiLimits";
+import { emojiInputCls } from "@/components/EmojiFileFields";
+
+const ERR: Record<string, string> = {
+  BAD_PIN: "Sesi PIN kedaluwarsa, buka ulang halaman.",
+  NAME_TAKEN: "Nama itu sudah dipakai emoji lain. Ubah namanya dulu.",
+  INVALID_NAME: `Nama harus 1–${EMOJI_NAME_MAX} karakter.`,
+  INVALID_PRICE: `Harga harus bilangan bulat 0–${EMOJI_PRICE_MAX.toLocaleString("id-ID")}.`,
+};
+const errText = (e: unknown, fallback: string) => {
+  const msg = String((e as { message?: string; code?: string })?.message || (e as { code?: string })?.code || "");
+  const hit = Object.keys(ERR).find((k) => msg.includes(k));
+  return hit ? ERR[hit] : fallback;
+};
+
+/** Panel konfirmasi usulan emoji pemain: admin menentukan nama + harga lalu Terima, atau Tolak. */
+export default function EmojiSuggestionsAdmin({
+  pin,
+  onApproved,
+  onPreview,
+}: {
+  pin: string;
+  onApproved: () => void;
+  onPreview: (e: { image_path: string; sound_path: string }) => void;
+}) {
+  const [list, setList] = useState<EmojiSuggestion[] | null>(null);
+  const [edits, setEdits] = useState<Record<string, { name: string; price: string }>>({});
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [ok, setOk] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    try {
+      setList(await adminListEmojiSuggestions(pin));
+      setError(null);
+    } catch (e) {
+      setError(errText(e, "Gagal memuat usulan emoji."));
+    }
+  }, [pin]);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  const get = (s: EmojiSuggestion) => edits[s.id] ?? { name: s.name, price: "" };
+  const set = (s: EmojiSuggestion, patch: Partial<{ name: string; price: string }>) =>
+    setEdits((prev) => ({ ...prev, [s.id]: { ...get(s), ...patch } }));
+
+  async function approve(s: EmojiSuggestion) {
+    const { name, price } = get(s);
+    setBusyId(s.id);
+    setError(null);
+    setOk(null);
+    try {
+      await adminApproveEmojiSuggestion(pin, s.id, name.trim(), Number(price));
+      setOk(`✓ “${name.trim()}” diterima dan tampil di toko.`);
+      await load();
+      onApproved();
+    } catch (e) {
+      setError(errText(e, "Gagal menerima usulan."));
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  async function reject(s: EmojiSuggestion) {
+    setBusyId(s.id);
+    setError(null);
+    setOk(null);
+    try {
+      await adminRejectEmojiSuggestion(pin, s.id);
+      setOk(`Usulan “${s.name}” ditolak.`);
+      await load();
+    } catch (e) {
+      setError(errText(e, "Gagal menolak usulan."));
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  return (
+    <section className="rise w-full rounded-3xl bg-white p-4 shadow-soft">
+      <h2 className="text-base font-extrabold text-ink">Usulan Emoji{list ? ` (${list.length})` : ""}</h2>
+      <p className="mt-1 text-xs text-ink-soft">Dari pemain. Tentukan harga lalu Terima agar tampil di toko.</p>
+
+      {error && (
+        <p key={error} className="mt-3 animate-shake text-sm font-medium text-coral-text" role="alert">
+          {error}
+        </p>
+      )}
+      {ok && <p className="mt-3 animate-pop-in text-sm font-semibold text-sage-text">{ok}</p>}
+
+      {list === null ? (
+        !error && <p className="mt-3 animate-pulse-soft text-sm text-ink-soft">Memuat…</p>
+      ) : list.length === 0 ? (
+        <p className="mt-3 text-sm text-ink-soft">Belum ada usulan emoji.</p>
+      ) : (
+        <ul className="mt-3 space-y-3">
+          {list.map((s) => {
+            const { name, price } = get(s);
+            const priceOk = /^\d+$/.test(price) && Number(price) <= EMOJI_PRICE_MAX;
+            const nameOk = name.trim().length >= 1 && name.trim().length <= EMOJI_NAME_MAX;
+            const busy = busyId === s.id;
+            return (
+              <li key={s.id} className="rounded-2xl bg-bg-end/60 p-3">
+                <div className="flex items-center gap-3">
+                  {/* eslint-disable-next-line @next/next/no-img-element */}
+                  <img src={emojiAssetUrl(s.image_path)} alt="" className="h-14 w-14 shrink-0 object-contain" />
+                  <p className="min-w-0 flex-1 text-xs text-ink-soft">
+                    Diusulkan oleh <b className="text-ink">{s.suggested_by ?? "—"}</b>
+                  </p>
+                  <button
+                    onClick={() => onPreview(s)}
+                    aria-label={`Preview ${s.name}`}
+                    className="min-h-[44px] shrink-0 rounded-xl bg-white px-3 text-xs font-bold text-ink shadow-soft-sm transition active:scale-95"
+                  >
+                    👁 Preview
+                  </button>
+                </div>
+                <div className="mt-3 grid grid-cols-[1fr_6.5rem] gap-2">
+                  <input
+                    value={name}
+                    onChange={(e) => set(s, { name: e.target.value })}
+                    maxLength={EMOJI_NAME_MAX}
+                    className={emojiInputCls}
+                    aria-label="Nama emoji"
+                  />
+                  <input
+                    value={price}
+                    onChange={(e) => set(s, { price: e.target.value.replace(/\D/g, "").slice(0, 6) })}
+                    inputMode="numeric"
+                    placeholder="Harga 🪙"
+                    className={emojiInputCls}
+                    aria-label="Harga koin"
+                  />
+                </div>
+                <div className="mt-3 grid grid-cols-2 gap-2">
+                  <button
+                    onClick={() => reject(s)}
+                    disabled={busy}
+                    className="min-h-[44px] rounded-xl bg-white px-2 text-sm font-bold text-ink shadow-soft-sm transition active:scale-95 disabled:opacity-50"
+                  >
+                    Tolak
+                  </button>
+                  <button
+                    onClick={() => approve(s)}
+                    disabled={busy || !nameOk || !priceOk}
+                    className="sheen min-h-[44px] rounded-xl bg-gradient-to-r from-accent-from to-accent-to px-2 text-sm font-bold text-ink shadow-soft-sm transition active:scale-95 disabled:opacity-50"
+                  >
+                    {busy ? "Memproses…" : "Terima"}
+                  </button>
+                </div>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </section>
+  );
+}
diff --git a/src/components/NewsTicker.tsx b/src/components/NewsTicker.tsx
new file mode 100644
index 0000000..ff66eab
--- /dev/null
+++ b/src/components/NewsTicker.tsx
@@ -0,0 +1,81 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { fetchTodayNews, type NewsItem } from "@/lib/gameActions";
+
+const SPEED = 60; // px per detik
+const GAP_MS = 3000; // jeda setelah satu berita selesai, sebelum berita berikutnya
+
+/**
+ * Running text 1 baris di beranda: berita hari ini (usulan kata/emoji yang diterima).
+ * Satu berita berjalan dari kanan ke kiri; setelah selesai, jeda 3 detik, lalu berita berikutnya
+ * (berputar). Disentuh/di-hover = berhenti sebentar. Tanpa berita hari ini, tidak tampil.
+ */
+export default function NewsTicker() {
+  const [items, setItems] = useState<NewsItem[]>([]);
+  const [i, setI] = useState(0);
+  const boxRef = useRef<HTMLDivElement>(null);
+  const textRef = useRef<HTMLSpanElement>(null);
+  const animRef = useRef<Animation | null>(null);
+
+  useEffect(() => {
+    let alive = true;
+    fetchTodayNews().then((n) => alive && setItems(n));
+    return () => {
+      alive = false;
+    };
+  }, []);
+
+  useEffect(() => {
+    const box = boxRef.current;
+    const text = textRef.current;
+    if (!box || !text || items.length === 0) return;
+
+    let timer: ReturnType<typeof setTimeout>;
+    const next = () => {
+      timer = setTimeout(() => setI((n) => (n + 1) % items.length), GAP_MS);
+    };
+
+    // Hormati "kurangi gerakan": tampil diam di tengah, berganti tiap 4 detik.
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+      text.style.cssText = "left:50%;transform:translateX(-50%)";
+      timer = setTimeout(() => setI((n) => (n + 1) % items.length), 4000);
+      return () => clearTimeout(timer);
+    }
+
+    // Teks mulai tepat di luar tepi kanan (left:100%), berakhir tepat di luar tepi kiri.
+    const dist = box.offsetWidth + text.offsetWidth;
+    const anim = text.animate(
+      [{ transform: "translateX(0)" }, { transform: `translateX(-${dist}px)` }],
+      { duration: (dist / SPEED) * 1000, easing: "linear", fill: "forwards" }
+    );
+    animRef.current = anim;
+    anim.onfinish = next;
+    return () => {
+      anim.cancel();
+      animRef.current = null;
+      clearTimeout(timer);
+    };
+  }, [i, items]);
+
+  if (items.length === 0) return null;
+  const n = items[i % items.length];
+  const label = n.kind === "word" ? "kata" : "emoji";
+
+  return (
+    <div
+      ref={boxRef}
+      // Jeda hanya saat berjalan; play() pada animasi yang sudah selesai akan mengulanginya dari awal.
+      onPointerEnter={() => animRef.current?.playState === "running" && animRef.current.pause()}
+      onPointerLeave={() => animRef.current?.playState === "paused" && animRef.current.play()}
+      className="relative h-9 w-full overflow-hidden rounded-2xl bg-gradient-to-r from-accent-from to-accent-to text-sm text-ink shadow-soft-sm"
+      role="status"
+      aria-live="off"
+      aria-label={`Berita hari ini: usulan ${label} ${n.name} diterima`}
+    >
+      <span key={i} ref={textRef} className="absolute left-full top-0 flex h-full items-center whitespace-nowrap font-medium">
+        📰&nbsp;Penambahan usulan {label}&nbsp;<b className="font-extrabold">“{n.name}”</b>&nbsp;diterima
+      </span>
+    </div>
+  );
+}
diff --git a/src/lib/emojiServer.ts b/src/lib/emojiServer.ts
new file mode 100644
index 0000000..b1b0656
--- /dev/null
+++ b/src/lib/emojiServer.ts
@@ -0,0 +1,100 @@
+import { NextResponse } from "next/server";
+import { createClient, type SupabaseClient } from "@supabase/supabase-js";
+import { randomUUID } from "crypto";
+import { EMOJI_BUCKET, EMOJI_IMAGE_MAX_BYTES, EMOJI_SOUND_MAX_BYTES } from "@/lib/emojiLimits";
+
+/** Helper bersama route server emoji (admin & usulan pemain). Hanya untuk dipakai di server. */
+
+type Detected = { kind: "image" | "sound"; ext: string; mime: string };
+
+/** Tipe file ditentukan dari isi (magic bytes), bukan dari nama/Content-Type kiriman klien. */
+export function detect(b: Buffer): Detected | null {
+  const ascii = (from: number, to: number) => b.subarray(from, to).toString("latin1");
+  if (b.length < 12) return null;
+  if (b[0] === 0x89 && ascii(1, 4) === "PNG") return { kind: "image", ext: "png", mime: "image/png" };
+  if (b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return { kind: "image", ext: "jpg", mime: "image/jpeg" };
+  if (ascii(0, 4) === "GIF8") return { kind: "image", ext: "gif", mime: "image/gif" };
+  if (ascii(0, 4) === "RIFF" && ascii(8, 12) === "WEBP") return { kind: "image", ext: "webp", mime: "image/webp" };
+  if (ascii(0, 4) === "RIFF" && ascii(8, 12) === "WAVE") return { kind: "sound", ext: "wav", mime: "audio/wav" };
+  if (ascii(0, 3) === "ID3" || (b[0] === 0xff && (b[1] & 0xe0) === 0xe0)) return { kind: "sound", ext: "mp3", mime: "audio/mpeg" };
+  if (ascii(0, 4) === "OggS") return { kind: "sound", ext: "ogg", mime: "audio/ogg" };
+  if (ascii(4, 8) === "ftyp") return { kind: "sound", ext: "m4a", mime: "audio/mp4" };
+  if (b[0] === 0x1a && b[1] === 0x45 && b[2] === 0xdf && b[3] === 0xa3) return { kind: "sound", ext: "webm", mime: "audio/webm" };
+  return null;
+}
+
+export const fail = (status: number, error: string) => NextResponse.json({ error }, { status });
+
+const clientOpts = { auth: { persistSession: false, autoRefreshToken: false } };
+
+/** anon = klien biasa (RPC ber-PIN/token); admin = service-role (Storage). Atau Response galat konfigurasi. */
+export function serverClients(): { anon: SupabaseClient; admin: SupabaseClient } | NextResponse {
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+  const anonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
+  const serviceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  if (!url || !anonKey) return fail(500, "CONFIG_SUPABASE");
+  if (!serviceKey) return fail(500, "CONFIG_SERVICE_KEY");
+  return { anon: createClient(url, anonKey, clientOpts), admin: createClient(url, serviceKey, clientOpts) };
+}
+
+let bucketReady = false;
+async function ensureBucket(admin: SupabaseClient) {
+  if (bucketReady) return;
+  const { data } = await admin.storage.getBucket(EMOJI_BUCKET);
+  if (!data) {
+    const { error } = await admin.storage.createBucket(EMOJI_BUCKET, {
+      public: true, // dibaca lewat URL publik (CDN); tulis hanya lewat service-role
+      fileSizeLimit: EMOJI_SOUND_MAX_BYTES,
+    });
+    // "sudah ada" akibat balapan antar-instance bukan masalah
+    if (error && !/already exists/i.test(error.message)) throw error;
+  }
+  bucketReady = true;
+}
+
+export interface EmojiFiles {
+  imageBuf: Buffer;
+  imageType: Detected;
+  soundBuf: Buffer;
+  soundType: Detected;
+}
+
+/** Baca & validasi field "image" + "sound" (ukuran dan tipe asli file). */
+export async function readEmojiFiles(form: FormData): Promise<EmojiFiles | NextResponse> {
+  const image = form.get("image");
+  const sound = form.get("sound");
+  if (!(image instanceof File) || !(sound instanceof File)) return fail(400, "FILES_REQUIRED");
+  if (image.size > EMOJI_IMAGE_MAX_BYTES) return fail(413, "IMAGE_TOO_LARGE");
+  if (sound.size > EMOJI_SOUND_MAX_BYTES) return fail(413, "SOUND_TOO_LARGE");
+  const imageBuf = Buffer.from(await image.arrayBuffer());
+  const soundBuf = Buffer.from(await sound.arrayBuffer());
+  const imageType = detect(imageBuf);
+  const soundType = detect(soundBuf);
+  if (!imageType || imageType.kind !== "image") return fail(415, "IMAGE_TYPE");
+  if (!soundType || soundType.kind !== "sound") return fail(415, "SOUND_TYPE");
+  return { imageBuf, imageType, soundBuf, soundType };
+}
+
+/** Unggah gambar + suara (path acak + immutable, aman di-cache CDN selamanya). Melempar bila gagal. */
+export async function uploadEmojiFiles(admin: SupabaseClient, f: EmojiFiles) {
+  const id = randomUUID();
+  const imagePath = `img/${id}.${f.imageType.ext}`;
+  const soundPath = `snd/${id}.${f.soundType.ext}`;
+  await ensureBucket(admin);
+  const up1 = await admin.storage.from(EMOJI_BUCKET).upload(imagePath, f.imageBuf, {
+    contentType: f.imageType.mime, cacheControl: "31536000", upsert: false,
+  });
+  if (up1.error) throw up1.error;
+  const up2 = await admin.storage.from(EMOJI_BUCKET).upload(soundPath, f.soundBuf, {
+    contentType: f.soundType.mime, cacheControl: "31536000", upsert: false,
+  });
+  if (up2.error) {
+    await admin.storage.from(EMOJI_BUCKET).remove([imagePath]);
+    throw up2.error;
+  }
+  return { imagePath, soundPath };
+}
+
+export async function removeEmojiFiles(admin: SupabaseClient, paths: string[]) {
+  await admin.storage.from(EMOJI_BUCKET).remove(paths);
+}
