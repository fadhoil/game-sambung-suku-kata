+
+// ---------- usulan emoji dari pemain ----------
+
+/** Pemain (ber-akun) mengusulkan emoji; masuk antrean konfirmasi admin. */
+export async function suggestEmoji(input: {
+  name: string;
+  image: Blob;
+  imageName: string;
+  sound: File;
+}): Promise<void> {
+  const token = getAccountToken();
