NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Agora (voice chat di Lobi & Hasil). Ambil dari Agora Console > Project Management.
# App ID tidak rahasia (dipakai klien); App Certificate RAHASIA (server-only) ->
# jangan commit nilai asli. Aktifkan "App Certificate" di project Agora agar
# endpoint /api/agora-token bisa membuat token.
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Toko emoji: route server /api/admin/emoji mengunggah gambar & suara ke Supabase Storage.
# Service-role key bersifat SANGAT RAHASIA (server-only, JANGAN diberi awalan NEXT_PUBLIC_).
# Ambil di Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
