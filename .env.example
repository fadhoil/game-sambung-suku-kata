NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LiveKit (voice chat di Lobi & Hasil). Ambil dari dashboard project LiveKit Cloud.
# API key & secret bersifat RAHASIA (server-only) -> jangan commit nilai asli.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project-xxxx.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Toko emoji: route server /api/admin/emoji mengunggah gambar & suara ke Supabase Storage.
# Service-role key bersifat SANGAT RAHASIA (server-only, JANGAN diberi awalan NEXT_PUBLIC_).
# Ambil di Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
